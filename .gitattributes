# These run on the Linux box. A CRLF shebang makes them unrunnable, with an
# error that names bash rather than the line ending, which wastes a while.
*.sh text eol=lf
# The same goes for everything deployed there: systemd units choke on CRLF, and a
# stray \r once turned a model name into "gemma4:26b\r" in the boot preload.
brain/** text eol=lf
ops/** text eol=lf
persona/** text eol=lf
scripts/** text eol=lf
tests/** text eol=lf
voice-training/** text eol=lf
# Never rewrite line endings inside a PDF; it corrupts the file.
*.pdf binary
*.STL filter=lfs diff=lfs merge=lfs -text
*.sldprt filter=lfs diff=lfs merge=lfs -text
*.sldasm filter=lfs diff=lfs merge=lfs -text
*.slddrw filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.SLDASM filter=lfs diff=lfs merge=lfs -text
*.STEP filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.SLDPRT filter=lfs diff=lfs merge=lfs -text
*.SLDDRW filter=lfs diff=lfs merge=lfs -text

# Keep the imported CAD packages byte-for-byte intact, including their manifests.
hardware/cad/** -text
