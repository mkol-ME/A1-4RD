[Unit]
Description=MI50 fan curve (motherboard PWM header driven by GPU temperature)
After=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe nct6775
ExecStart=/usr/bin/python3 /usr/local/sbin/mi50-fan.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
